{
  "name": "kq-call-summary",
  "main": "src/index.js",
  "compatibility_date": "2026-03-06",
  "observability": {
    "enabled": true
  }
  // No HF_MODEL var: the worker walks its own MODEL_CHAIN (src/index.js), so a
  // model the router drops can't break summaries. Set HF_MODEL only to try a
  // specific model first.
}